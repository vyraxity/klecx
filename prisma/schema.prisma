generator client {
  provider = "prisma-client"
  output   = "../server/db/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ProjectRole {
  VIEWER
  COMMENTER
  EDITOR
  ADMIN
}

enum WorkspaceRole {
  VIEWER
  COMMENTER
  EDITOR
  ADMIN
}

enum TitleSource {
  AUTO
  USER
}

model User {
  id                      String              @id
  name                    String
  email                   String              @unique
  emailVerified           Boolean             @default(false)
  image                   String?
  role                    UserRole            @default(USER)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  /// Step 9.5: set when the person deletes the account (sign-in blocked at once);
  /// cleared if they restore it. After 30 days the row is anonymized, never removed.
  deletedAt               DateTime?           @map("deleted_at")
  /// Step 8.6: suspended by an admin (abuse, AUP violation). Can't sign in; sessions are revoked.
  suspendedAt             DateTime?           @map("suspended_at")
  /// Internal note on why (never shown to the person).
  suspendedReason         String?             @map("suspended_reason")
  /// Two-factor sign-in (TOTP app + backup codes) is on. Set by Better Auth's
  /// twoFactor plugin once the first code is verified.
  twoFactorEnabled        Boolean             @default(false) @map("two_factor_enabled")
  twoFactor               TwoFactor?
  sessions                Session[]
  accounts                Account[]
  projects                Project[]
  workspaces              Workspace[]
  projectMemberships      ProjectMember[]
  workspaceMemberships    WorkspaceMember[]
  creditAccount           CreditAccount?
  preference              UserPreference?
  supportTickets          SupportTicket[]
  attachments             Attachment[]        @relation("UserAttachments")
  annotations             Annotation[]        @relation("AnnotationCreator")
  annotationMessages      AnnotationMessage[] @relation("AnnotationMessageAuthor")
  promotions              Promotion[]         @relation("PromotionCreator")
  username                String?             @unique
  displayUsername         String?             @map("display_username")
  usernameChangeCount     Int                 @default(0) @map("username_change_count")
  usernameChangedAt       DateTime?           @map("username_changed_at")
  usernameClaimedAt       DateTime?           @map("username_claimed_at")
  welcomeEmailSentAt      DateTime?           @map("welcome_email_sent_at")
  auditLogs               AuditLog[]
  avatarAttachmentId      String?             @unique @map("avatar_attachment_id")
  avatarAttachment        Attachment?         @relation("UserAvatarAttachment", fields: [avatarAttachmentId], references: [id], onDelete: SetNull)
  sentInvitations         Invitation[]        @relation("SentInvitations")
  receivedInvitations     Invitation[]        @relation("ReceivedInvitations")
  activityLogs            ActivityLog[]       @relation("ActorActivityLogs")
  createdShareLinks       ShareLink[]         @relation("CreatedShareLinks")
  notifications           Notification[]
  sentTransfers           OwnershipTransfer[] @relation("TransfersSent")
  receivedTransfers       OwnershipTransfer[] @relation("TransfersReceived")
  memberLimitGrace        MemberLimitGrace?
  subscription            Subscription?
  billingCheckouts        BillingCheckout[]
  billingConsents         BillingConsent[]
  annotationMentions      AnnotationMention[]
  workspaceNotes          WorkspaceNote[]     @relation("WorkspaceNoteCreator")
  documentRevisionsEdited DocumentRevision[]
  dataExports             DataExport[]
  accountDeletion         AccountDeletion?

  @@map("users")
}

/// Two-factor sign-in (Better Auth `twoFactor` plugin). The TOTP secret and the
/// backup codes are encrypted with BETTER_AUTH_SECRET. `verified` is false until
/// the first code is entered during setup. Repeated wrong codes lock it briefly.
model TwoFactor {
  id                      String    @id
  userId                  String    @unique @map("user_id")
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factors")
}

model Session {
  id          String   @id
  userId      String
  token       String   @unique
  expiresAt   DateTime
  ipAddress   String?
  userAgent   String?
  country     String?
  deviceLabel String?
  client      String?  @default("web")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Project {
  id                 String              @id @default(uuid(7))
  ownerId            String
  name               String
  description        String?
  archivedAt         DateTime?
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  workspaces         Workspace[]
  members            ProjectMember[]
  invitations        Invitation[]
  activityLogs       ActivityLog[]
  ownershipTransfers OwnershipTransfer[]

  @@index([ownerId, deletedAt, updatedAt(sort: Desc)])
  @@map("projects")
}

model Workspace {
  id                 String              @id @default(uuid(7))
  ownerId            String
  projectId          String?
  sourceWorkspaceId  String?             @map("source_workspace_id")
  sourceAnnotationId String?             @map("source_annotation_id")
  sourceMessageId    String?             @map("source_message_id")
  title              String
  titleSource        TitleSource         @default(AUTO)
  archivedAt         DateTime?
  deletedAt          DateTime?
  lastActivityAt     DateTime            @default(now())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  project            Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  members            WorkspaceMember[]
  responses          Response[]
  generations        Generation[]
  attachments        Attachment[]
  annotations        Annotation[]
  invitations        Invitation[]
  activityLogs       ActivityLog[]
  shareLinks         ShareLink[]
  ownershipTransfers OwnershipTransfer[]
  notes              WorkspaceNote[]
  documents          Document[]

  @@index([ownerId, deletedAt, lastActivityAt(sort: Desc)])
  @@index([projectId, deletedAt])
  @@index([sourceWorkspaceId])
  @@map("workspaces")
}

model ProjectMember {
  id               String      @id @default(uuid(7))
  projectId        String
  userId           String
  role             ProjectRole
  monthlyCreditCap Int?        @default(300) @map("monthly_credit_cap")
  canComment       Boolean?    @map("can_comment")
  canAsk           Boolean?    @map("can_ask")
  suspendedAt      DateTime?   @map("suspended_at")
  suspendedReason  String?     @map("suspended_reason")
  keepActive       Boolean     @default(false) @map("keep_active")
  invitedById      String
  createdAt        DateTime    @default(now())
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model WorkspaceMember {
  id               String        @id @default(uuid(7))
  workspaceId      String
  userId           String
  role             WorkspaceRole
  monthlyCreditCap Int?          @default(300) @map("monthly_credit_cap")
  canComment       Boolean?      @map("can_comment")
  canAsk           Boolean?      @map("can_ask")
  suspendedAt      DateTime?     @map("suspended_at")
  suspendedReason  String?       @map("suspended_reason")
  keepActive       Boolean       @default(false) @map("keep_active")
  invitedById      String
  createdAt        DateTime      @default(now())
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

enum LedgerType {
  GRANT
  RESERVE
  SETTLE
  RELEASE
  REFUND
  EXPIRE
  ADJUST
}

model CreditAccount {
  id            String         @id @default(uuid(7))
  userId        String         @unique @map("user_id")
  planBalance   Int            @default(0) @map("plan_balance")
  topupBalance  Int            @default(0) @map("topup_balance")
  /// Plan whose allowance `planBalance` holds (Step 8.4). FREE after a paid plan ends.
  allowancePlan PlanKey        @default(FREE) @map("allowance_plan")
  /// Step 8.6: frozen by an admin; nothing may spend these credits (`reserve()` → `credits_frozen`).
  frozenAt      DateTime?      @map("frozen_at")
  frozenReason  String?        @map("frozen_reason")
  /// Ledger key of the current allowance, e.g. `free:<userId>:2026-11`,
  /// `creem:paid:<transaction>` or `yearly:<subscription>:<start>:<n>`. Null = not stamped yet.
  allowanceKey  String?        @map("allowance_key")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger        CreditLedger[]

  @@map("credit_accounts")
}

model CreditLedger {
  id             String        @id @default(uuid(7))
  accountId      String        @map("account_id")
  type           LedgerType
  planDelta      Int           @map("plan_delta")
  topupDelta     Int           @map("topup_delta")
  planAfter      Int           @map("plan_after")
  topupAfter     Int           @map("topup_after")
  generationId   String?       @map("generation_id")
  actorId        String?       @map("actor_id")
  reason         String?
  estimated      Boolean       @default(false)
  idempotencyKey String        @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  account        CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt(sort: Desc)])
  @@index([generationId])
  @@map("credit_ledger")
}

enum ResponseKind {
  TEXT
  IMAGE
  DOCUMENT
}

enum ResponseOrigin {
  DIRECT
  PROMOTED
  UPLOAD
}

enum VersionStatus {
  STREAMING
  COMPLETE
  FAILED
}

model Response {
  id                   String            @id @default(uuid(7))
  workspaceId          String            @map("workspace_id")
  createdById          String            @map("created_by_id")
  prompt               String            @db.Text
  kind                 ResponseKind      @default(TEXT)
  origin               ResponseOrigin    @default(DIRECT)
  sortAt               DateTime          @default(now()) @map("sort_at")
  activeVersionId      String?           @unique @map("active_version_id")
  uploadedAttachmentId String?           @unique @map("uploaded_attachment_id")
  deletedAt            DateTime?         @map("deleted_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  workspace            Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions             ResponseVersion[]
  attachments          Attachment[]
  uploadedAttachment   Attachment?       @relation("UploadedDocumentResponse", fields: [uploadedAttachmentId], references: [id], onDelete: SetNull)
  annotations          Annotation[]
  shareLinks           ShareLink[]
  quote                String?           @db.Text
  sourceAnnotationId   String?           @map("source_annotation_id")

  @@index([workspaceId, deletedAt, sortAt, id])
  @@map("responses")
}

model ResponseVersion {
  id              String         @id @default(uuid(7))
  responseId      String         @map("response_id")
  number          Int
  status          VersionStatus  @default(STREAMING)
  content         String         @default("") @db.Text
  thoughtSummary  String?        @map("thought_summary") @db.Text
  modelKey        String         @map("model_key")
  providerModelId String         @map("provider_model_id")
  promptVersion   String         @map("prompt_version")
  generationId    String?        @unique @map("generation_id")
  sourceMessageId String?        @map("source_message_id")
  createdById     String         @map("created_by_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  response        Response       @relation(fields: [responseId], references: [id], onDelete: Cascade)
  edits           ResponseEdit[]
  citations       Citation[]
  annotations     Annotation[]
  documents       Document[]

  @@unique([responseId, number])
  @@index([responseId, createdAt])
  @@index([sourceMessageId])
  @@map("response_versions")
}

model ResponseEdit {
  id        String          @id @default(uuid(7))
  versionId String          @map("version_id")
  revision  Int
  content   String          @db.Text
  editorId  String          @map("editor_id")
  createdAt DateTime        @default(now()) @map("created_at")
  version   ResponseVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, revision])
  @@map("response_edits")
}

model Document {
  id              String    @id @default(uuid(7))
  workspaceId     String    @map("workspace_id")
  versionId       String    @map("version_id") // the response version that created it
  title           String
  format          String // "md" | "docx" | "pdf"
  currentRevision Int       @default(1) @map("current_revision")
  createdById     String    @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  deletedAt       DateTime? @map("deleted_at")

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  version     ResponseVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  revisions   DocumentRevision[]
  annotations Annotation[]

  @@index([workspaceId, createdAt])
  @@index([versionId])
  @@map("documents")
}

model DocumentRevision {
  id         String   @id @default(uuid(7))
  documentId String   @map("document_id")
  revision   Int
  content    String   @db.Text // Markdown source of truth
  editorId   String?  @map("editor_id") // null = generated by Klecx
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  editor   User?    @relation(fields: [editorId], references: [id], onDelete: SetNull)

  @@unique([documentId, revision])
  @@map("document_revisions")
}

enum GenStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum GenKind {
  TEXT
  IMAGE
  ANNOTATION_REPLY
  QUESTION_BATCH
  TITLE
  SPEECH
  DOCUMENT_REVIEW
  TRANSCRIPTION
}

model Generation {
  id              String    @id @default(uuid(7))
  workspaceId     String?   @map("workspace_id")
  responseId      String?   @map("response_id")
  versionId       String?   @map("version_id")
  actorId         String    @map("actor_id")
  billedAccountId String    @map("billed_account_id")
  kind            GenKind
  status          GenStatus @default(QUEUED)
  modelKey        String    @map("model_key")
  providerModelId String    @map("provider_model_id")
  promptVersion   String    @map("prompt_version")
  idempotencyKey  String    @map("idempotency_key")
  reservedCredits Int       @default(0) @map("reserved_credits")
  chargedCredits  Int       @default(0) @map("charged_credits")
  usage           Json?
  errorCode       String?   @map("error_code")
  startedAt       DateTime? @map("started_at")
  /// Step 10.2: when the first text arrived (time to first token); null for non-streamed calls.
  firstTokenAt    DateTime? @map("first_token_at")
  finishedAt      DateTime? @map("finished_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([actorId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@index([status, startedAt])
  @@index([billedAccountId, createdAt])
  @@index([billedAccountId, actorId, createdAt])
  @@map("generations")
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

/// Step 9.2: Settings → Appearance → Density (compact applies from tablet width up).
enum DensityPreference {
  COMFORTABLE
  COMPACT
}

/// Step 9.2: a row is written only on the first change; reads apply the
/// defaults (server/services/user-preferences.ts). Nullable fields mean
/// "not chosen on the account".
model UserPreference {
  userId              String            @id @map("user_id")
  uiLocale            String?           @map("ui_locale")
  aiLanguage          String?           @map("ai_language")
  webSearchEnabled    Boolean           @default(true) @map("web_search_enabled")
  notificationPrefs   Json?             @map("notification_prefs")
  /// null = never chosen on the account: the device's `theme` cookie decides.
  theme               ThemePreference?
  enterToSend         Boolean           @default(true) @map("enter_to_send")
  /// null = follow the device's setting; true = always reduce motion.
  reduceMotion        Boolean?          @map("reduce_motion")
  /// Step 9.4 (read-aloud) uses these; not writable before then.
  voiceProvider       String?           @map("voice_provider")
  voiceId             String?           @map("voice_id")
  voiceSpeed          Float             @default(1) @map("voice_speed")
  onboardingDismissed Boolean           @default(false) @map("onboarding_dismissed")
  density             DensityPreference @default(COMFORTABLE)
  updatedAt           DateTime          @updatedAt @map("updated_at")
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String       @id @default(uuid(7))
  userId      String?      @map("user_id")
  email       String
  topic       String
  message     String       @db.Text
  diagnostics Json?
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now()) @map("created_at")

  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  attachments SupportAttachment[]

  @@index([email, createdAt])
  @@index([status, createdAt])
  @@map("support_tickets")
}

/// A screenshot attached to a support request (F5.8). Stored re-encoded,
/// without metadata, in a private folder `support/<ticketId>/`.
/// Deleted after 90 days (job in main-guide Step 10.3).
model SupportAttachment {
  id         String   @id @default(uuid(7))
  ticketId   String   @map("ticket_id")
  providerId String   @map("provider_id")
  mime       String
  bytes      Int
  width      Int?
  height     Int?
  createdAt  DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
  @@map("support_attachments")
}

enum AttachmentKind {
  IMAGE
  DOCUMENT
  GENERATED_IMAGE
  GENERATED_DOCUMENT
  AVATAR
  AUDIO
}

enum AttachmentStatus {
  PENDING
  READY
  REJECTED
  DELETED
}

model Attachment {
  id            String           @id @default(uuid(7))
  ownerId       String           @map("owner_id")
  workspaceId   String?          @map("workspace_id")
  responseId    String?          @map("response_id")
  kind          AttachmentKind
  status        AttachmentStatus @default(PENDING)
  providerId    String           @map("provider_id")
  resourceType  String           @map("resource_type")
  mime          String
  bytes         Int
  width         Int?
  height        Int?
  originalName  String           @map("original_name")
  sha256        String?
  extractedText String?          @map("extracted_text") @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")
  deletedAt     DateTime?        @map("deleted_at")

  user                     User       @relation("UserAttachments", fields: [ownerId], references: [id], onDelete: Cascade)
  avatarUser               User?      @relation("UserAvatarAttachment")
  workspace                Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  response                 Response?  @relation(fields: [responseId], references: [id], onDelete: SetNull)
  uploadedDocumentResponse Response?  @relation("UploadedDocumentResponse")

  @@index([workspaceId, createdAt])
  @@index([ownerId])
  @@index([status, createdAt])
  @@map("attachments")
}

enum CitationSource {
  GROUNDING
  ATTACHMENT
  MODEL_PROVIDED
}

model Citation {
  id        String         @id @default(uuid(7))
  versionId String         @map("version_id")
  index     Int
  url       String
  title     String?
  snippet   String?        @db.Text
  source    CitationSource @default(GROUNDING)
  createdAt DateTime       @default(now()) @map("created_at")

  version ResponseVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, index])
  @@index([versionId])
  @@map("citations")
}

enum AnnotationKind {
  COMMENT
  ASK
}

enum AnnotationTarget {
  RESPONSE_VERSION
  ANNOTATION_MESSAGE
  DOCUMENT_REVISION
}

enum AuthorType {
  USER
  AI
}

enum SuggestionState {
  PENDING
  ACCEPTED
  REJECTED
  STALE
}

enum QuestionState {
  NONE
  QUEUED
  ANSWERING
  ANSWERED
  CANCELLED
  FAILED
}

enum Visibility {
  PRIVATE
  WORKSPACE
}

enum ContentSource {
  ORIGINAL
  EDIT
}

enum MsgRole {
  USER
  ASSISTANT
}

model Annotation {
  id                 String           @id @default(uuid(7))
  workspaceId        String           @map("workspace_id")
  responseId         String?          @map("response_id")
  versionId          String?          @map("version_id")
  targetType         AnnotationTarget @default(RESPONSE_VERSION) @map("target_type")
  targetMessageId    String?          @map("target_message_id")
  documentId         String?          @map("document_id")
  documentRevision   Int?             @map("document_revision")
  parentAnnotationId String?          @map("parent_annotation_id")
  rootAnnotationId   String?          @map("root_annotation_id")
  depth              Int              @default(0)
  authorType         AuthorType       @default(USER) @map("author_type")
  suggestion         Json?
  suggestionState    SuggestionState? @map("suggestion_state")
  contentSource      ContentSource    @default(ORIGINAL) @map("content_source")
  editRevision       Int?             @map("edit_revision")
  createdById        String           @map("created_by_id")
  kind               AnnotationKind
  questionState      QuestionState    @default(NONE) @map("question_state")
  visibility         Visibility       @default(PRIVATE)
  resolvedAt         DateTime?        @map("resolved_at")
  deletedAt          DateTime?        @map("deleted_at")
  anchorExact        String           @map("anchor_exact") @db.Text
  anchorPrefix       String           @map("anchor_prefix")
  anchorSuffix       String           @map("anchor_suffix")
  anchorStart        Int?             @map("anchor_start")
  anchorEnd          Int?             @map("anchor_end")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  response      Response?           @relation(fields: [responseId], references: [id], onDelete: Cascade)
  version       ResponseVersion?    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  createdBy     User                @relation("AnnotationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  targetMessage AnnotationMessage?  @relation("AnnotationsOnMessage", fields: [targetMessageId], references: [id], onDelete: Cascade)
  parent        Annotation?         @relation("AnnotationChildren", fields: [parentAnnotationId], references: [id], onDelete: Cascade)
  children      Annotation[]        @relation("AnnotationChildren")
  root          Annotation?         @relation("AnnotationRoot", fields: [rootAnnotationId], references: [id], onDelete: Cascade)
  descendants   Annotation[]        @relation("AnnotationRoot")
  messages      AnnotationMessage[] @relation("AnnotationThreadMessages")
  promotions    Promotion[]
  notes         WorkspaceNote[]
  document      Document?           @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([versionId, deletedAt])
  @@index([workspaceId, createdById, questionState])
  @@index([responseId])
  @@index([targetMessageId, deletedAt])
  @@index([rootAnnotationId])
  @@index([documentId, documentRevision])
  @@map("annotations")
}

model AnnotationMessage {
  id             String   @id @default(uuid(7))
  annotationId   String   @map("annotation_id")
  role           MsgRole
  content        String   @db.Text
  authorId       String?  @map("author_id")
  generationId   String?  @unique @map("generation_id")
  thoughtSummary String?  @map("thought_summary") @db.Text
  citations      Json?
  status         String   @default("COMPLETE")
  modelKey       String?  @map("model_key")
  createdAt      DateTime @default(now()) @map("created_at")

  annotation    Annotation          @relation("AnnotationThreadMessages", fields: [annotationId], references: [id], onDelete: Cascade)
  author        User?               @relation("AnnotationMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  promotions    Promotion[]
  annotationsOn Annotation[]        @relation("AnnotationsOnMessage")
  mentions      AnnotationMention[]
  note          WorkspaceNote?

  @@index([annotationId, createdAt])
  @@map("annotation_messages")
}

model AnnotationMention {
  id        String            @id @default(uuid(7))
  messageId String            @map("message_id")
  userId    String?           @map("user_id")
  isKlecx   Boolean           @default(false) @map("is_klecx")
  createdAt DateTime          @default(now()) @map("created_at")
  message   AnnotationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
  @@map("annotation_mentions")
}

enum NoteStatus {
  ACTIVE
  ARCHIVED
}

model WorkspaceNote {
  id           String            @id @default(uuid(7))
  workspaceId  String            @map("workspace_id")
  annotationId String            @map("annotation_id")
  messageId    String            @unique @map("message_id")
  createdById  String            @map("created_by_id")
  quote        String            @db.Text
  instruction  String            @db.Text
  status       NoteStatus        @default(ACTIVE)
  createdAt    DateTime          @default(now()) @map("created_at")
  archivedAt   DateTime?         @map("archived_at")
  /// Set when the author's account is deleted (soft delete). A deleted note is hidden everywhere.
  deletedAt    DateTime?         @map("deleted_at")
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  annotation   Annotation        @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  // The note goes with the message that recorded it. Accounts are soft-deleted
  // (User.deletedAt), which soft-deletes the author's notes; the cascade only
  // matters if a user row is ever removed for good.
  message      AnnotationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("WorkspaceNoteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@index([annotationId])
  @@map("workspace_notes")
}

enum PromotionTarget {
  TIMELINE
  NEW_WORKSPACE
}

model Promotion {
  id                     String          @id @default(uuid(7))
  annotationId           String          @map("annotation_id")
  messageId              String          @map("message_id")
  target                 PromotionTarget
  destinationResponseId  String?         @map("destination_response_id")
  destinationWorkspaceId String?         @map("destination_workspace_id")
  createdById            String          @map("created_by_id")
  createdAt              DateTime        @default(now()) @map("created_at")

  annotation Annotation        @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  message    AnnotationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdBy  User              @relation("PromotionCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([messageId, target])
  @@index([annotationId])
  @@index([destinationResponseId])
  @@index([destinationWorkspaceId])
  @@map("promotions")
}

model AuditLog {
  id        String   @id @default(uuid(7))
  userId    String   @map("user_id")
  action    String
  targetId  String?  @map("target_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invitation {
  id            String       @id @default(uuid(7))
  workspaceId   String?      @map("workspace_id")
  projectId     String?      @map("project_id")
  email         String
  invitedUserId String?      @map("invited_user_id")
  role          String
  tokenHash     String       @unique @map("token_hash")
  status        InviteStatus @default(PENDING)
  invitedById   String       @map("invited_by_id")
  expiresAt     DateTime     @map("expires_at")
  acceptedAt    DateTime?    @map("accepted_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy   User       @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser User?      @relation("ReceivedInvitations", fields: [invitedUserId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([workspaceId])
  @@index([projectId])
  @@map("invitations")
}

model ActivityLog {
  id          String   @id @default(uuid(7))
  workspaceId String?  @map("workspace_id")
  projectId   String?  @map("project_id")
  actorId     String   @map("actor_id")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor     User       @relation("ActorActivityLogs", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("activity_log")
}

enum ShareScope {
  WORKSPACE
  RESPONSE
}

model ShareLink {
  id           String     @id @default(uuid(7))
  workspaceId  String     @map("workspace_id")
  responseId   String?    @map("response_id")
  scope        ShareScope
  view         String     @default("EDITED_IF_AVAILABLE")
  tokenHash    String     @unique @map("token_hash")
  tokenPrefix  String     @map("token_prefix")
  showAuthor   Boolean    @default(false) @map("show_author")
  expiresAt    DateTime?  @map("expires_at")
  revokedAt    DateTime?  @map("revoked_at")
  createdById  String     @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  viewCount    Int        @default(0) @map("view_count")
  lastViewedAt DateTime?  @map("last_viewed_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  response  Response? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CreatedShareLinks", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("share_links")
}

enum NotifStatus {
  UNREAD
  READ
  DISMISSED
}

enum EmailStatus {
  NONE
  PENDING
  SENT
  FAILED
}

model Notification {
  id          String      @id @default(uuid(7))
  userId      String      @map("user_id")
  type        String
  payload     Json
  dedupeKey   String?     @map("dedupe_key")
  status      NotifStatus @default(UNREAD)
  emailStatus EmailStatus @default(NONE) @map("email_status")
  /// Step 10.3: delivery attempts so far (the inline send counts as one) and
  /// when the `send-emails` job may try again (null: nothing left to try).
  emailAttempts      Int       @default(0) @map("email_attempts")
  emailNextAttemptAt DateTime? @map("email_next_attempt_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  readAt      DateTime?   @map("read_at")
  dismissedAt DateTime?   @map("dismissed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([emailStatus, emailNextAttemptAt])
  @@map("notifications")
}

enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

model OwnershipTransfer {
  id                  String         @id @default(uuid(7))
  workspaceId         String?        @map("workspace_id")
  projectId           String?        @map("project_id")
  fromUserId          String         @map("from_user_id")
  toUserId            String         @map("to_user_id")
  previousOwnerAction String         @default("STAY_ADMIN") @map("previous_owner_action")
  status              TransferStatus @default(PENDING)
  expiresAt           DateTime       @map("expires_at")
  respondedAt         DateTime?      @map("responded_at")
  createdAt           DateTime       @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromUser  User       @relation("TransfersSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser    User       @relation("TransfersReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([workspaceId])
  @@index([projectId])
  @@map("ownership_transfers")
}

model MemberLimitGrace {
  id          String    @id @default(uuid(7))
  ownerId     String    @unique @map("owner_id")
  limit       Int
  graceEndsAt DateTime  @map("grace_ends_at")
  /// When `enforceMemberLimit` ran after the grace ended (Step 8.4); null while pending.
  enforcedAt  DateTime? @map("enforced_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("member_limit_grace")
}

// Step 8.1: billing. One subscription row per user; webhooks (Step 8.3) write it,
// `getEntitlements()` reads it to decide the effective plan.
enum PlanKey {
  FREE
  LITE
  STANDARD
  PRO
}

enum SubStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
  DISPUTED
}

model Subscription {
  id                     String    @id @default(uuid(7))
  userId                 String    @unique @map("user_id")
  plan                   PlanKey
  /// "month" | "year"
  interval               String
  status                 SubStatus
  providerCustomerId     String?   @map("provider_customer_id")
  providerSubscriptionId String?   @unique @map("provider_subscription_id")
  currentPeriodStart     DateTime? @map("current_period_start")
  currentPeriodEnd       DateTime? @map("current_period_end")
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  /// Time of the newest provider event applied; older, out-of-order webhooks are ignored.
  lastEventAt            DateTime? @map("last_event_at")
  /// Start day ("2026-10-05") of the last period granted by `subscription.paid` (Step 8.3/8.5).
  lastGrantPeriod        String?   @map("last_grant_period")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model BillingEvent {
  id              String    @id @default(uuid(7))
  provider        String
  providerEventId String    @map("provider_event_id")
  type            String
  payload         Json
  /// RECEIVED | PROCESSED | IGNORED | FAILED
  status          String    @default("RECEIVED")
  error           String?
  /// The person the event was applied to (Step 8.3); null until resolved. Kept after account deletion.
  userId          String?   @map("user_id")
  receivedAt      DateTime  @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")

  @@unique([provider, providerEventId])
  @@index([userId, receivedAt])
  @@map("billing_events")
}

/// Consent to immediate start of a paid plan (Step 8.5): the person asked for
/// the service to start at once and acknowledged losing the statutory 14-day
/// withdrawal right where it applies (EU/UK). One row per checkout or upgrade,
/// kept as evidence for refund requests and disputes.
model BillingConsent {
  id         String   @id @default(uuid(7))
  userId     String   @map("user_id")
  /// "checkout" | "plan_change"
  kind       String
  plan       PlanKey
  /// "month" | "year"
  interval   String
  /// Version of the consent wording shown (`CHECKOUT_CONSENT_VERSION`).
  version    String
  /// Our checkout id (`BillingCheckout.id`) for a checkout.
  checkoutId String?  @map("checkout_id")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("billing_consents")
}

/// A hosted checkout we started (Step 8.3). Its id is the `request_id` sent to
/// the provider, so a webhook can be traced back to the buyer without trusting an email.
model BillingCheckout {
  id                 String   @id
  userId             String   @map("user_id")
  plan               PlanKey
  /// "month" | "year"
  interval           String
  providerCheckoutId String?  @map("provider_checkout_id")
  createdAt          DateTime @default(now()) @map("created_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("billing_checkouts")
}

/// Step 9.4: synthesized read-aloud audio, shared by everyone who plays the
/// same text with the same voice (a hit costs nothing and calls no provider).
/// `key` = sha256(text, provider, model, voice).
model SpeechCache {
  id         String   @id @default(uuid(7))
  key        String   @unique
  provider   String
  modelId    String   @map("model_id")
  voiceId    String   @map("voice_id")
  chars      Int
  seconds    Float
  /// Storage public id (private asset, resource type "video" for audio).
  storageId  String   @map("storage_id")
  mime       String
  bytes      Int
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  @@index([lastUsedAt])
  @@map("speech_cache")
}

/// Step 9.5: a copy of the person's data as a ZIP (Settings → Your data).
/// Built in the background after the request; the file is private and can be
/// downloaded by its owner for 24 h after it's ready.
enum DataExportStatus {
  PENDING
  READY
  FAILED
}

model DataExport {
  id            String           @id @default(uuid(7))
  userId        String           @map("user_id")
  status        DataExportStatus @default(PENDING)
  /// Storage public id of the ZIP (private, resource type "raw").
  storageId     String?          @map("storage_id")
  bytes         Int?
  filesIncluded Int              @default(0) @map("files_included")
  filesSkipped  Int              @default(0) @map("files_skipped")
  errorCode     String?          @map("error_code")
  createdAt     DateTime         @default(now()) @map("created_at")
  finishedAt    DateTime?        @map("finished_at")
  /// Download allowed until then (24 h after it's ready); the file is deleted after.
  expiresAt     DateTime?        @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("data_exports")
}

/// Step 9.5: an account deletion. `User.deletedAt` blocks sign-in at once;
/// the account can be restored with the emailed link until `purgeAfter`
/// (30 days), then its content is erased and the user row anonymized
/// (`purgeDeletedAccount()`); billing and credit records are kept.
model AccountDeletion {
  id               String    @id @default(uuid(7))
  userId           String    @unique @map("user_id")
  requestedAt      DateTime  @default(now()) @map("requested_at")
  purgeAfter       DateTime  @map("purge_after")
  /// sha256 of the restore link's token (the token itself is only in the email).
  restoreTokenHash String    @unique @map("restore_token_hash")
  purgedAt         DateTime? @map("purged_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([purgeAfter, purgedAt])
  @@map("account_deletions")
}

/// Step 10.2: how often a person ran into a plan limit, per day (abuse signal
/// for the alerts: e.g. hitting the search cap every day). `kind`:
/// DAILY_CREDIT_CAP | CONCURRENCY | SEARCH_CAP | VOICE_CAP | READ_ALOUD_CAP.
model UsageLimitHit {
  id      String   @id @default(uuid(7))
  userId  String   @map("user_id")
  kind    String
  day     DateTime @db.Date
  count   Int      @default(1)
  firstAt DateTime @default(now()) @map("first_at")
  lastAt  DateTime @default(now()) @map("last_at")

  @@unique([userId, kind, day])
  @@index([day])
  @@map("usage_limit_hits")
}

/// Step 10.2: one row per alert condition (e.g. `provider_errors`,
/// `account_cost:<userId>`), so the same alert isn't emailed again within its
/// quiet period and admins can see the history.
model MonitoringAlert {
  id          String    @id @default(uuid(7))
  key         String    @unique
  severity    String
  summary     String
  details     Json?
  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  lastSentAt  DateTime? @map("last_sent_at")
  occurrences Int       @default(1)

  @@index([lastSeenAt])
  @@map("monitoring_alerts")
}

/// Step 10.3: one lease per background job, so overlapping runs (a slow run,
/// a scheduler retry) do nothing. Taken with one atomic upsert; it expires by
/// itself (`lockedUntil`) if the function running the job is killed.
model JobLock {
  job         String   @id
  lockedUntil DateTime @map("locked_until")
  holder      String
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("job_locks")
}

/// Step 10.3: one row per background job run (history for the alerts:
/// failed, unfinished or overdue jobs). `status`: RUNNING | SUCCEEDED |
/// FAILED | SKIPPED (another run held the lock). Kept 30 days.
model JobRun {
  id         String    @id @default(uuid(7))
  job        String
  status     String
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  /// Counts only (what the job did), never ids of people or content.
  result     Json?
  errorCode  String?   @map("error_code")

  @@index([job, startedAt(sort: Desc)])
  @@index([startedAt])
  @@map("job_runs")
}

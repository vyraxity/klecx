# Every variable is explained in README.md ("Environment variables"). Copy this file to
# .env.local and fill in the values. An empty value counts as unset. Never commit real values.

# --- Required -----------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/klecx_v2_dev?schema=public"
# Optional: non-pooled URL for Prisma migrations, when DATABASE_URL is a pooler (e.g. PgBouncer in transaction mode).
DIRECT_URL=

APP_URL="http://localhost:3000"

# At least 32 random characters: openssl rand -base64 48
BETTER_AUTH_SECRET="CHANGE_ME"

# The AI provider's key. Locally, any 10+ characters together with AI_PROVIDER="fake".
GEMINI_API_KEY="CHANGE_ME_API_KEY"

# Starts with re_. In development "re_dev_placeholder" prints emails (and their links) in the terminal.
RESEND_API_KEY="re_dev_placeholder"

EMAIL_FROM="Klecx <onboarding@resend.dev>"

# --- Sign-in with Google / GitHub (optional; set both values of a provider) -----
# Redirect URIs: <APP_URL>/api/auth/callback/google and <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI models -------------------------------------------------------------------
# Fast & Efficient tier (credits are priced for this model).
GEMINI_TEXT_MODEL_ECONOMY="gemini-3.1-flash-lite"
# Standard Reasoning tier, paid plans (credits are priced for this model).
GEMINI_TEXT_MODEL_STANDARD="gemini-3.8-flash"
# Older single-model setting, only a fallback for the economy model.
GEMINI_TEXT_MODEL=""

GEMINI_IMAGE_MODEL="gemini-nano-banana-2.1"

# Voice input (F4.5). Must accept audio. Unset, it uses the economy text model.
AI_TRANSCRIBE_MODEL=""

# Read-aloud with natural voices (Step 9.4): a text-to-speech model.
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"

# --- Site identity and contact addresses ----------------------------------------
# Required in production: SUPPORT_EMAIL, PRIVACY_EMAIL, ABUSE_EMAIL, COMPANY_LEGAL_NAME,
# COMPANY_ADDRESS, COMPANY_COUNTRY.
SUPPORT_EMAIL=support@example.com
PRIVACY_EMAIL=privacy@example.com
ABUSE_EMAIL=abuse@example.com
LEGAL_EMAIL=legal@example.com
BILLING_EMAIL=billing@example.com
# Security reports, published in /.well-known/security.txt (defaults to SUPPORT_EMAIL).
SECURITY_EMAIL=security@example.com
COMPANY_LEGAL_NAME="Vyraxity"
COMPANY_ADDRESS="Lagos, Nigeria"
COMPANY_COUNTRY="NG"
COMPANY_REG_NUMBER=
COMPANY_WEBSITE="https://vyraxity.com"
SOCIAL_X_URL=
SOCIAL_GITHUB_URL=
# Optional: a public status/incident page. /status links to it when set.
STATUS_PAGE_URL=
BILLING_ENABLED="false"

# Image generation (text-only launch): leave off until Creem approves the store with
# Customer Credits + Moderation API for images. Inlined at build time: rebuild after changing.
NEXT_PUBLIC_IMAGE_GENERATION_ENABLED="false"

# Emergency switch: "true" sends every page to /maintenance (health checks still answer).
MAINTENANCE_MODE="false"

# Billing provider (Step 8.2). Test mode first: the test API base with the test API key
# (Creem dashboard → Test Mode toggle → Developers). Live: https://api.creem.io with the live key.
BILLING_PROVIDER=creem
CREEM_API_BASE=https://test-api.creem.io
CREEM_API_KEY=
# Step 8.3: the webhook signing secret (Developers → Webhooks, or the secret `creem listen`
# prints for local testing). Webhook URL: https://<your-domain>/api/webhooks/creem
CREEM_WEBHOOK_SECRET=
# One Creem product per plan and billing period (prod_…).
CREEM_PRODUCT_LITE_MONTH=
CREEM_PRODUCT_LITE_YEAR=
CREEM_PRODUCT_STANDARD_MONTH=
CREEM_PRODUCT_STANDARD_YEAR=
CREEM_PRODUCT_PRO_MONTH=
CREEM_PRODUCT_PRO_YEAR=

# Tests only (Step 10.4, docs/testing.md). Leave empty on every real deployment:
# AI_PROVIDER="fake" uses the deterministic test AI (no network), refused in production;
# E2E_TEST_MODE="true" is the end-to-end test mode (test inbox, fake Creem), refused on Vercel.
AI_PROVIDER=""
E2E_TEST_MODE=""

# File storage (Cloudinary). All three or none (none: an in-memory mock, development only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Every stored file goes under this folder, one per environment (e.g. klecx/dev, klecx/prod).
# Cloud name for the browser. Empty: CLOUDINARY_CLOUD_NAME.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_FOLDER="klecx/dev"
# The account's folder mode: "dynamic" (newer accounts) or "fixed" (older ones). Empty: Klecx
# asks Cloudinary once. In dynamic mode, uploads also send asset_folder so files appear in
# their folders in the Media Library.
CLOUDINARY_FOLDER_MODE=""

# Required in production; optional in development/test (falls back to in-memory store).
# If one is provided, both must be provided.
UPSTASH_REDIS_REST_URL=""

UPSTASH_REDIS_REST_TOKEN=""

# Set to "true" ONLY when deployed behind a trusted reverse proxy (e.g. Vercel,
# Cloudflare, Nginx) that strips or overwrites incoming X-Forwarded-For / X-Real-IP headers.
TRUST_PROXY="false"

# Step 10.1: the Content-Security-Policy is enforced. Set to "true" to send it
# as report-only instead (a switch if it blocks something after a deploy).
CSP_REPORT_ONLY="false"
# Step 10.1: passwords found in known data breaches are refused (only a 5-character
# hash prefix is sent to the Pwned Passwords service). "false" turns the check off.
PWNED_PASSWORD_CHECK="true"

# The plan of accounts without a subscription (FREE, LITE, STANDARD, PRO). Development only —
# ignored in production.
DEV_DEFAULT_PLAN="PRO"

# Vercel only: "true" lets a preview build run the migrations (set it for the dev branch only).
MIGRATE_ON_PREVIEW=""

# End-to-end tests (docs/testing.md): a separate database, never the development one.
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/klecx_e2e"

# --- Step 10.2: observability -------------------------------------------------
# Log level for the JSON logs (fatal, error, warn, info, debug). Default: info.
LOG_LEVEL="info"
# Monitoring alerts (provider errors, costs, webhooks…) go here. Defaults to BILLING_EMAIL.
ALERTS_EMAIL=alerts@example.com
# Background jobs (Step 10.3): the scheduler calls /api/cron/<job> with "Authorization: Bearer <CRON_SECRET>".
# At least 32 random characters (e.g. `openssl rand -base64 48`), different per environment. Empty: jobs refused.
CRON_SECRET=""
# Sentry error tracking: OFF while empty. The DSN is public (it only allows sending events).
NEXT_PUBLIC_SENTRY_DSN=""
# Share of requests traced for performance (0 to 1). 0 = errors only.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0"
# Source-map upload at build time (Vercel only; leave empty locally). The auth token is a secret.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
